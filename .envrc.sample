# =========
# Network
# =========

export API_LISTENING_PORT=3000

# =========
# Database
# =========

# Database URL format is
# postgresql://$USER:$PASSWORD@$HOST:$PORT/$DATABASE_NAME

export DATABASE_URL=postgresql://postgres:password@localhost/postgres

export DATABASE_ARCHIVE_URL=postgresql://postgres:password@localhost/archive

# =========
# Dependencies
# =========

# RNIPP
export RNIPP_BASE_URL=$URL

export RNIPP_TIMEOUT_MILLISECONDS=500

# PAJEMPLOI
export PAJEMPLOI_BASE_URL=$URL

export PAJEMPLOI_TIMEOUT_MILLISECONDS=500

# =========
# Fake
# =========

export FAKE_RNIPP_API_LISTENING_PORT=3001

export FAKE_PAJEMPLOI_API_LISTENING_PORT=3002

# =========
# Monitoring
# =========

export SENTRY_DSN=$URL