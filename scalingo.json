{
  "name": "Review App",
  "env": {
    "REVIEW_APP": {
      "description": "Indicates that the application is a review app",
      "value": "true"
    }
  },
  "addons": [
    {
      "plan": "postgresql:postgresql-starter-512",
      "options": {
        "version": "18.6"
      }
    }
  ],
  "formation": {
    "web": {
      "amount": 1,
      "size": "S"
    }
  },
  "scripts": {
    "first-deploy": "npm run database:migrate && npm run database:seed"
  },
  "stack": "scalingo-26"
}
